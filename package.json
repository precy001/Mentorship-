{
  "name": "mentorship-plus-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "mobile:start": "expo start",
    "mobile:android": "expo start --android",
    "mobile:ios": "expo start --ios",
    "api:install": "npm --prefix api install",
    "api:dev": "npm --prefix api run start:dev",
    "api:build": "npm --prefix api run build",
    "api:test": "npm --prefix api test -- --runInBand",
    "api:db:validate": "npm --prefix api run db:validate",
    "api:db:generate": "npm --prefix api run prisma:generate",
    "api:db:migrate": "npm --prefix api run prisma:migrate:deploy",
    "api:db:seed": "npm --prefix api run prisma:seed"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.27",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
