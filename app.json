{
  "expo": {
    "name": "Mentorship+",
    "slug": "guidance-plus-mobile",
    "scheme": "guidanceplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#FFFFFF",
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.guidanceplus.app",
      "backgroundColor": "#FFFFFF",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#2133FF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.guidanceplus.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3f0aa89-9026-40c6-b29c-d4a797b58a3f"
      }
    },
    "owner": "ultimatedev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3f0aa89-9026-40c6-b29c-d4a797b58a3f"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    }
  }
}