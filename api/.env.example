# Copy the relevant additions into your existing api/.env; do not replace your real DATABASE_URL.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
# Email deep links. Keep these routes aligned with app.json's Expo scheme and app routes.
AUTH_VERIFICATION_URL="guidanceplus://verify"
AUTH_PASSWORD_RESET_URL="guidanceplus://reset-password"
# Legacy verification URL alias; retained for older deployments. It does not control password-reset links.
AUTH_ACTION_BASE_URL="guidanceplus://verify"
# Configure SMTP to send actual email. In development without SMTP, links are printed to the API terminal only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Profile image storage (create a public Supabase Storage bucket named profile-photos).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-photos
