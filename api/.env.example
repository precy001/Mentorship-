# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Use a local PostgreSQL database or the connection string supplied by your managed provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mentorship_plus?schema=public"
# Comma-separated exact origins. Do not use * in production when credentials are enabled.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
LOG_LEVEL=log
