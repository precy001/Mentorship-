# Copy the relevant additions into your existing api/.env; do not replace your real DATABASE_URL.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
# Public action URL is used in emails. Replace with your real app/deep-link URL when configured.
AUTH_ACTION_BASE_URL="guidanceplus://verify"
# Configure SMTP to send actual email. In development without SMTP, links are printed to the API terminal only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
